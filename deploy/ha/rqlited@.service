[Unit]
Description=MaestroVPN HA rqlite 10.1.0 voter %i (inert template)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3
ConditionFileIsExecutable=/opt/maestro/ha/rqlite/10.1.0/rqlited
ConditionFileNotEmpty=/etc/maestro/ha/rqlite-%i.env
ConditionPathIsDirectory=/var/lib/maestro/rqlite/%i
ConditionFileNotEmpty=/var/lib/maestro/rqlite/%i/raft.db

[Service]
Type=simple
User=maestro-rqlite
Group=maestro-rqlite
EnvironmentFile=/etc/maestro/ha/rqlite-%i.env
WorkingDirectory=/var/lib/maestro/rqlite/%i
ExecStart=/opt/maestro/ha/rqlite/10.1.0/rqlited -node-id %i -fk -http-addr ${RQLITE_HTTP_ADDR} -http-adv-addr ${RQLITE_HTTP_ADV_ADDR} -http-ca-cert ${RQLITE_HTTP_CA_CERT} -http-cert ${RQLITE_HTTP_CERT} -http-key ${RQLITE_HTTP_KEY} -http-verify-client -raft-addr ${RQLITE_RAFT_ADDR} -raft-adv-addr ${RQLITE_RAFT_ADV_ADDR} -node-ca-cert ${RQLITE_RAFT_CA_CERT} -node-cert ${RQLITE_RAFT_CERT} -node-key ${RQLITE_RAFT_KEY} -node-verify-client /var/lib/maestro/rqlite/%i
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/maestro/ha/rqlite/10.1.0 /etc/maestro/ha/pki /etc/maestro/ha/secrets
ReadWritePaths=/var/lib/maestro/rqlite/%i
LimitNOFILE=65536
TasksMax=1024
