# Values are rendered only into a protected S4 stage.
worker_processes 1;
error_log stderr crit;
pid /run/maestro-cdn-ingress/nginx.pid;
events { worker_connections 2048; }
http {
    access_log off;
    client_body_temp_path /var/lib/maestro-cdn-ingress/body;
    proxy_temp_path /var/lib/maestro-cdn-ingress/proxy;
    fastcgi_temp_path /var/lib/maestro-cdn-ingress/fastcgi;
    scgi_temp_path /var/lib/maestro-cdn-ingress/scgi;
    uwsgi_temp_path /var/lib/maestro-cdn-ingress/uwsgi;
    client_max_body_size 4m;
    client_header_buffer_size 16k;
    large_client_header_buffers 4 64k;
    gzip off;
    server {
        listen 0.0.0.0:28080;
        server_name <PUBLIC_HOST>;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        location = <PRIVATE_XHTTP_PATH> {
            proxy_pass http://127.0.0.1:18081;
        }
        location ^~ <PRIVATE_XHTTP_PATH>/ {
            proxy_pass http://127.0.0.1:18081;
        }
        location = <COMMERCIAL_XHTTP_PATH> {
            proxy_pass http://127.0.0.1:28081;
        }
        location ^~ <COMMERCIAL_XHTTP_PATH>/ {
            proxy_pass http://127.0.0.1:28081;
        }
        location / { return 404; }
    }
}
