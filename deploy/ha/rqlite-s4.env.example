# Inert example. Replace the private bind placeholder only in a reviewed node plan.
RQLITE_HTTP_ADDR=__S4_PRIVATE_IP__:4001
RQLITE_HTTP_ADV_ADDR=s4-rqlite-http.internal:4001
RQLITE_HTTP_CA_CERT=/etc/maestro/ha/pki/rqlite-http/ca.pem
RQLITE_HTTP_CERT=/etc/maestro/ha/pki/rqlite-http/s4-http-server.pem
RQLITE_HTTP_KEY=/etc/maestro/ha/secrets/rqlite-http/s4-http-server.key
RQLITE_RAFT_ADDR=__S4_PRIVATE_IP__:4002
RQLITE_RAFT_ADV_ADDR=s4-rqlite-raft.internal:4002
RQLITE_RAFT_CA_CERT=/etc/maestro/ha/pki/rqlite-raft/ca.pem
RQLITE_RAFT_CERT=/etc/maestro/ha/pki/rqlite-raft/s4-raft-peer.pem
RQLITE_RAFT_KEY=/etc/maestro/ha/secrets/rqlite-raft/s4-raft-peer.key
