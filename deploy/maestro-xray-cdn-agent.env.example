# Non-secret identity and filesystem paths only. Credentials and private keys
# are provisioned separately with read access restricted to the service identity.
MAESTRO_RELEASE_ID=release-id-from-immutable-manifest
MAESTRO_CONFIG_DIGEST=sha256-from-materialized-xray-config
MAESTRO_RECEIPT_DIRECTORY=/var/lib/maestro-xray-cdn-agent/receipts
MAESTRO_CREDENTIAL_DIRECTORY=/var/lib/maestro-xray-cdn-agent/credentials
MAESTRO_XRAY_PID_FILE=/run/maestro-xray-cdn-pid/xray.pid
MAESTRO_XRAY_CONFIG_FILE=/run/maestro-xray-cdn/config.json
MAESTRO_ACTIVE_ORIGIN_IPS_FILE=/etc/maestro-xray-cdn-agent/active-origin-ips.json
MAESTRO_RELAY_CA_DIRECTORY=/etc/maestro-xray-cdn-agent/relay-ca
MAESTRO_RELAY_CREDENTIAL_DIRECTORY=/var/lib/maestro-xray-cdn-agent/relay-credentials
MAESTRO_NFT_BINARY=/usr/sbin/nft
MAESTRO_AGENT_SERVER_CERT=/etc/maestro-xray-cdn-agent/server/server.crt
MAESTRO_AGENT_SERVER_KEY=/etc/maestro-xray-cdn-agent/server/server.key
MAESTRO_CONTROLLER_CA=/etc/maestro-xray-cdn-agent/controller-ca/client-ca.crt
MAESTRO_XRAY_CLIENT_CERT=/etc/maestro-xray-cdn/api-mtls/sidecar-agent.crt
MAESTRO_XRAY_CLIENT_KEY=/etc/maestro-xray-cdn/api-mtls/sidecar-agent.key
MAESTRO_XRAY_API_CA=/etc/maestro-xray-cdn/api-mtls/server-ca.crt
MAESTRO_XRAY_API_SERVER_NAME=maestro-xray-api
