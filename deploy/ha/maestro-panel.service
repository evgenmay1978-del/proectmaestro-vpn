[Unit]
Description=MaestroVPN HA panel exact artifact (inert template)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3
ConditionFileIsExecutable=/opt/maestro/ha/releases/f577c67ad229fe89278430d35a3ec65f6ce454e5/maestro-panel
ConditionFileNotEmpty=/etc/maestro/ha/maestro-panel.env
ConditionPathIsDirectory=/var/lib/maestro/panel

[Service]
Type=simple
User=maestro-panel
Group=maestro-panel
EnvironmentFile=/etc/maestro/ha/maestro-panel.env
WorkingDirectory=/var/lib/maestro/panel
ExecStart=/opt/maestro/ha/releases/f577c67ad229fe89278430d35a3ec65f6ce454e5/maestro-panel
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/maestro/ha/releases/f577c67ad229fe89278430d35a3ec65f6ce454e5 /etc/maestro/ha/pki /etc/maestro/ha/secrets
ReadWritePaths=/var/lib/maestro/panel
LimitNOFILE=65536
TasksMax=512
