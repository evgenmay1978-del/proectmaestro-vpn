# Inert HA runtime example. Replace __NODE_ID__ with exactly s2, s3 or s4.
MAESTRO_LISTEN=127.0.0.1:8910
MAESTRO_CONTROL_PLANE=rqlite
MAESTRO_RQLITE_ENDPOINTS=https://s2-rqlite-http.internal:4001,https://s3-rqlite-http.internal:4001,https://s4-rqlite-http.internal:4001
MAESTRO_RQLITE_CA_FILE=/etc/maestro/ha/pki/rqlite-http/ca.pem
MAESTRO_RQLITE_CERT_FILE=/etc/maestro/ha/pki/rqlite-http/__NODE_ID__-panel-rqlite-client.pem
MAESTRO_RQLITE_KEY_FILE=/etc/maestro/ha/secrets/rqlite-http/__NODE_ID__-panel-rqlite-client.key
MAESTRO_RQLITE_KEY_BUNDLE_FILE=/etc/maestro/ha/secrets/control-plane/key-bundle.json
MAESTRO_REPORT_DIR=/var/lib/maestro/panel/reports
