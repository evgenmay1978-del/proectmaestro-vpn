[Unit]
Description=MaestroVPN control-plane backup -> Yandex Object Storage (gpg-encrypted)
After=network-online.target
Wants=network-online.target
Before=maestro-ha-backup.service maestro-ha-backup.timer
Conflicts=maestro-ha-backup.service maestro-ha-backup.timer
ConditionPathExists=/etc/maestro/control-plane-mode.env

[Service]
Type=oneshot
EnvironmentFile=/etc/maestro/control-plane-mode.env
ExecStart=/usr/local/bin/maestro-backup.sh
Nice=10
IOSchedulingClass=idle
