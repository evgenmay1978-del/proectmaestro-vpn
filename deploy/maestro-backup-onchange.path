[Unit]
Description=Back up MaestroVPN state immediately when it changes (provision/order)
Before=maestro-ha-backup.service maestro-ha-backup.timer
Conflicts=maestro-ha-backup.service maestro-ha-backup.timer
ConditionPathExists=/etc/maestro/control-plane-mode.env

[Path]
PathChanged=/var/lib/maestro/customers.json
PathChanged=/var/lib/maestro/orders.json
Unit=maestro-backup.service

[Install]
WantedBy=paths.target
